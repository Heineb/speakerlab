    "test:websocket-client": "node test/websocket-client.test.js",
    "test:client-initialization": "node test/client-extension-initialization.test.js",
    "test:product-information-client": "node test/product-information-client.test.js",
    "test:setup-navigation": "node test/setup-navigation.test.js",
    "test:local-server": "node test/local-server.test.js",
    "test:dsp-simulator": "node test/dsp-simulator.test.js",
    "test:signal-flow": "node test/signal-flow-model.test.js",
    "test:channel-processing": "node test/channel-processing-model.test.js",
    "test:gain-delay-polarity-ui": "node test/routing-ui.test.js",
    "test:crossover-model": "node test/crossover-model.test.js",
    "test:crossover-response": "node test/crossover-response.test.js",
    "test:channel-routing": "node test/channel-routing-service.test.js",
    "test:routing-contract": "node test/channel-routing-contract.test.js",
    "test:routing-ui": "node test/routing-ui.test.js",
    "test:crossover-ui": "node test/crossover-ui.test.js",
    "test:syntax-verification": "node test/verify-javascript-syntax.test.js",
    "test:settings-store": "node test/settings-store.test.js",
    "test:speaker-presets": "node test/speaker-preset-discovery.test.js",
    "test:listening-modes": "node test/listening-mode-discovery.test.js",
