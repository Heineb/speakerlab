    "test:settings-write": "node test/settings-write.test.js",
    "test:atomic-settings": "node test/atomic-settings.test.js",
    "test:configuration-write": "npm run test:settings-write && npm run test:atomic-settings",
    "test:configuration-backup": "node test/configuration-backup.test.js",
    "test:configuration-restore": "node test/configuration-restore.test.js",
    "test:configuration-api": "node test/configuration-api.test.js",
    "test:configuration-ui": "node test/configuration-ui.test.js",
    "test:ui-acceptance": "playwright test",
